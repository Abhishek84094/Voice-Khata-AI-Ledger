# Environment configuration for Voice Khata

APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_khata

# Field-level AES-256-GCM encryption key (base64-encoded 32 bytes)
LEDGER_KEY=your_base64_encoded_32_byte_key_here

# JWT Auth Secret
JWT_SECRET=your_jwt_secret_key_here

# Speech Providers
SARVAM_API_KEY=your_sarvam_api_key_here
GNANI_API_KEY=your_gnani_api_key_here_if_used

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here

# App settings
SHOPKEEPER_DEFAULT_LANGUAGE=hi-IN
TRANSCRIPT_POLICY=both
